# Base URL of the FastAPI backend (src/api/main.py runs on :8000 by default — API_PORT).
# Local dev only — in production (Vercel) this is set as a Project ->
# Environment Variable in the Vercel dashboard instead, pointing at the
# Render API service's URL (architecture.md §5, e.g.
# https://codebase-rag-api.onrender.com — no trailing slash, no /api). Vite inlines this at BUILD time, so
# Vercel must have it set before the build runs, not just at runtime.
VITE_API_BASE_URL=http://localhost:8000
