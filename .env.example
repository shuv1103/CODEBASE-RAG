# Local repo for the chunk_main.py / repo_loader.py CLIs (the API clones repos itself)
HOST_REPO_PATH=/path/to/your/repo

# Embeddings
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BATCH_SIZE=20
EMBEDDING_OUTPUT_DIMENSION=3072

# Chunking output (chunk_main.py writes it, embeddings_main.py reads it)
CHUNKS_JSON_PATH=/app/src/data/chunks/code_chunks.jsonl

# Vector store (Qdrant) — one collection for all repos, filtered by repo_id.
# Both local dev (docker-compose.yml passes these to api/worker via env_file)
# and production use your Qdrant Cloud cluster — there is no local Qdrant
# service. Cluster URL looks like https://<cluster>.<region>.<provider>.cloud.qdrant.io
# (CLAUDE.md §18/§20). Unset, QDRANT_URL falls back to http://localhost:6333.
QDRANT_URL=https://<cluster>.<region>.<provider>.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=code_chunks

# Retrieval
TOP_K=5

# Agent
AGENT_MODEL=gpt-4.1

# OpenAI (required — embeddings, agent, and ragas_eval)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_LLM_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EVALUATION_DATASET_PATH=

# Exponential Backoff (retry on 429 RESOURCE_EXHAUSTED)
# wait formula per attempt: (2^attempt) + random(0,1)  → ~1s, ~2s, ~5s, ~9s, ~17s
# attempt 0: ~1s  |  attempt 1: ~2s  |  attempt 2: ~5s  |  attempt 3: ~9s  |  attempt 4: ~17s
BACKOFF_MAX_RETRIES=5

# Redis — Celery broker/result backend AND the shared RedisStatusStore
# (repo status must be visible to both the api process and celery_worker
# process(es); an in-memory dict can't cross that boundary).
# Redis Cloud: copy the database's public endpoint + default-user password.
# Redis Cloud has only database 0, so all three URLs end in /0.
REDIS_URL=redis://default:<password>@<host>:<port>/0
CELERY_BROKER_URL=redis://default:<password>@<host>:<port>/0
CELERY_RESULT_BACKEND=redis://default:<password>@<host>:<port>/0
# 0 = no expiry (matches the old in-memory store's lifetime-of-process behavior).
REPO_STATUS_TTL_SECONDS=0
# Redis connection caps per process, to stay within the plan's client limit
# (Redis Cloud free: 30 across api + every worker + tools like Flower).
REDIS_STATUS_MAX_CONNECTIONS=5
CELERY_BROKER_POOL_LIMIT=2
CELERY_REDIS_MAX_CONNECTIONS=4

# Answer cache (src/caching/) — Redis LangCache serves both tiers: exact match
# (case-insensitive) and semantic match. Values are on the Redis Cloud console
# → LangCache → your service → Configuration. Define a "repo_id" attribute on
# the service (Attributes) — every entry is scoped to its repo.
LANGCACHE_ENABLED=true
LANGCACHE_SERVER_URL=https://<langcache-api-base-url>
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=
# Entry lifetime in seconds (3600 = 1 hour), then LangCache removes it.
LANGCACHE_TTL=3600
# Minimum similarity (0.5–1.0) for a semantic hit; unset = the service's own threshold.
LANGCACHE_SIMILARITY_THRESHOLD=0.92

# Ingestion guardrails (git_cloner.py / ingest_pipeline.py)
MAX_REPO_FILES=5000
MAX_REPO_BYTES=209715200
CLONE_TIMEOUT_SECONDS=120
INGESTION_TIMEOUT_SECONDS=900

# Observability (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=codebase-rag-agent
LANGSMITH_EVAL_DATASET_NAME=codebase-rag-eval
LANGSMITH_EVAL_EXPERIMENT_NAME=codebase-rag-eval

# API server (src/api/main.py). CORS fails closed: unset, only the local Vite
# dev server may call the API. In production set it to the Vercel origin
# (scheme + host, no trailing slash); comma-separate several origins.
API_CORS_ORIGINS=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000

# Logging (utils/logging_config.py): DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
