# Copy to .env and fill in; .env is git-ignored. Never commit real values.

# --- OpenAI (required) ---
OPENAI_API_KEY=your_openai_api_key_here
# Chat agent LLM; the API refuses to start without it.
AGENT_MODEL=gpt-4.1
# Must match the Qdrant collection's 3072-dim vectors.
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BATCH_SIZE=20

# --- OpenAI rate limiting ---
# Retries on embedding 429s (exponential backoff, capped wait per attempt).
BACKOFF_MAX_RETRIES=5
BACKOFF_MAX_WAIT_SECONDS=30
# LiteLLM retries for the chat LLM call.
LLM_NUM_RETRIES=3
# Shared requests/minute budget for API + workers, counted in Redis; 0 = off.
OPENAI_RPM_LIMIT=0
OPENAI_BUDGET_MAX_WAIT_SECONDS=30

# --- Qdrant Cloud (vector store; one collection, filtered by repo_id) ---
QDRANT_URL=https://<cluster>.<region>.<provider>.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=code_chunks
# HNSW index: links per node, build candidates, exact-scan cutoff (KB), search candidates.
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=200
QDRANT_HNSW_FULL_SCAN_THRESHOLD=10000
QDRANT_HNSW_EF=128

# --- Retrieval ---
# Code chunks retrieved per question.
TOP_K=3

# --- Redis Cloud (Celery broker + results, repo status) ---
# Same URL for all three; use redis:// if your plan has TLS off (/0 is optional).
REDIS_URL=rediss://default:<password>@<host>:<port>/0
CELERY_BROKER_URL=rediss://default:<password>@<host>:<port>/0
CELERY_RESULT_BACKEND=rediss://default:<password>@<host>:<port>/0
# Repo status record lifetime in seconds; 0 = never expires.
REPO_STATUS_TTL_SECONDS=0
# Per-process connection caps; the free plan allows 30 in total.
REDIS_STATUS_MAX_CONNECTIONS=5
CELERY_BROKER_POOL_LIMIT=2
CELERY_REDIS_MAX_CONNECTIONS=4

# --- Answer cache (Redis LangCache: exact + semantic) ---
# Console → LangCache → your service; it must define a "repo_id" attribute.
LANGCACHE_ENABLED=true
LANGCACHE_SERVER_URL=https://<langcache-api-base-url>
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=
# Cached answer lifetime in seconds.
LANGCACHE_TTL=3600
# Minimum similarity (0.5–1.0) for a semantic hit; higher = fewer wrong matches.
LANGCACHE_SIMILARITY_THRESHOLD=0.92

# --- Ingestion limits ---
MAX_REPO_FILES=5000
# Max bytes of files read from a clone (200 MB).
MAX_REPO_BYTES=209715200
# Max repo size per the GitHub API, checked before cloning (1 GiB).
MAX_REPO_DOWNLOAD_BYTES=1073741824
# Max chunks per repo; caps embedding spend.
MAX_REPO_CHUNKS=20000
CLONE_TIMEOUT_SECONDS=120
# Max ingestion time; a run silent for this + 120 s is marked failed.
INGESTION_TIMEOUT_SECONDS=3600

# --- API server ---
API_CORS_ORIGINS=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000
# Serves /docs and /openapi.json; keep false in production.
API_DOCS_ENABLED=false
# Larger request bodies get 413.
MAX_REQUEST_BYTES=65536

# --- Rate limits ---
# Per client IP.
CHAT_RATE_LIMIT=10/minute
CREATE_REPO_RATE_LIMIT=5/minute
# Across all clients (new ingestions only for the repo limit).
GLOBAL_CHAT_RATE_LIMIT=60/minute
GLOBAL_CREATE_REPO_RATE_LIMIT=20/hour
# Proxies in front of the API: 0 locally, 1 on Render.
TRUSTED_PROXY_HOPS=0
# memory:// for one API instance; the Redis URL when running several.
RATE_LIMIT_STORAGE_URI=memory://

# --- LLM concurrency & chat memory ---
# Agent runs in flight per API process; waiting longer than the timeout → 503.
MAX_CONCURRENT_LLM_CALLS=4
LLM_QUEUE_TIMEOUT_SECONDS=30
# Repos whose agent stays in memory, and idle seconds before a chat session is dropped.
AGENT_REGISTRY_MAX_REPOS=20
CHAT_SESSION_TTL_SECONDS=3600

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Tracing & evaluation (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=codebase-rag-agent
LANGSMITH_EVAL_DATASET_NAME=codebase-rag-eval
LANGSMITH_EVAL_EXPERIMENT_NAME=codebase-rag-eval
# RAGAS judge models and dataset (evaluation/run_eval.py).
OPENAI_LLM_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EVALUATION_DATASET_PATH=

# --- Local CLI only (scripts/; never needed in production) ---
HOST_REPO_PATH=/path/to/your/repo
CHUNKS_JSON_PATH=/app/src/backend/data/chunks/code_chunks.jsonl
EMBEDDING_OUTPUT_DIMENSION=3072
