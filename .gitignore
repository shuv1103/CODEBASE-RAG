# Environment files (real values); only the templates are committed
.env
.env.local
.env.*
!.env.example
*.pem
*.key

# Public/example project artifacts (don't commit large example repos)
/public/
/src/public/
.public/

# Local vector store / chunk output and DB files
src/backend/data/
*.sqlite3
*.db

# Run output
*.log
dump.rdb
celerybeat-schedule*
src/backend/evaluation/results.txt

# ADK session/artifact folders (ephemeral)
.adk/

# Python caches and virtualenvs
__pycache__/
*.py[cod]
env/
venv/
venv*/
.venv/
rag-implement/
*.egg-info/

# Test suite — kept local only, not committed
/tests/
pytest.ini

# Test / lint / type-check caches and coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Node dependencies and build output (src/frontend/)
node_modules/
dist/
*.tsbuildinfo

# Internal docs / notes - not for public repo
references/
graphify-out/
CLAUDE.md

# Editor / OS / local tooling
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db

# foglamp scan artifacts (scan.lock.json holds a secret edit token)
.foglamp/

# scripts for local developement
scripts/

